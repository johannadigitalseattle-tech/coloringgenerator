  /* ---------- almacenamiento seguro ---------- */
  const store = {
    get(k, fb) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : fb; } catch (e) { return fb; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* sin almacenamiento: sigue funcionando */ } }
  };

  let lang = store.get('cbg_lang', 'es');
  const t = k => (I18N[lang] && I18N[lang][k]) || I18N.en[k] || k;
  const L = o => (o ? o[lang] || o.en : '');

  /* ---------- estado ---------- */
  const fresh = () => ({
    style: null, count: '1', chars: [], customChar: '', outfit: null, customOutfit: '',
    details: [], theme: null, activity: null, customActivity: '', comp: null, compExtras: [],
    level: null, audience: null, format: null, layout: null, print: D.print.map(p => p.id), custom: ''
  });
  let state = fresh();
  const book = { world: null, pages: 20, char: null, customChar: '', style: null, audience: null, level: null };
  let current = '';      // prompt mostrado
  let manual = false;    // true cuando el resultado viene de "otra vez" o historial
  let bookPages = [];

  /* ---------- toast ---------- */
  let toastTimer;
  function toast(msg) {
    const el = $('toast'); el.textContent = msg; el.classList.add('show');
    clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('show'), 2200);
  }

  /* ---------- regla niños ---------- */
  function checkKids(obj) {
    if (obj.audience === 'kids' && ['detailed', 'intricate'].includes(obj.level)) { obj.level = 'easy'; toast(t('kidsNote')); }
  }

  /* =========================================================
     DESPLEGABLE CON CASILLAS
     cfg: options() | groups(), get(), set(ids), max(), search, multiPh
     ========================================================= */
  const dropdowns = [];
  function makeDD(id, cfg) {
    const root = $(id);
    root.innerHTML =
      '<button type="button" class="dd-trigger" aria-haspopup="listbox" aria-expanded="false"><span class="dd-value"></span>' +
      '<svg class="dd-caret" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>' +
      '<div class="dd-panel">' + (cfg.search ? '<input class="dd-search" type="search" autocomplete="off">' : '') +
      '<div class="dd-list" role="listbox"></div><div class="dd-foot"><span class="dd-count"></span><button type="button" class="dd-clear"></button></div></div>';
    const trig = root.querySelector('.dd-trigger');
    const list = root.querySelector('.dd-list');
    const search = root.querySelector('.dd-search');
    let q = '';

    const flat = () => cfg.groups ? cfg.groups().flatMap(g => g.items) : cfg.options();
    const match = o => !q || (o.es + ' ' + o.en).toLowerCase().includes(q);

    function optHTML(o, sel, max) {
      const on = sel.includes(o.id);
      const off = !on && max > 1 && sel.length >= max;
      return '<div class="dd-opt' + (on ? ' on' : '') + (off ? ' off' : '') + '" role="option" tabindex="0" aria-selected="' + on + '" data-id="' + o.id + '">' +
        '<span class="box" aria-hidden="true"></span>' + (o.i ? '<span class="dd-ico" aria-hidden="true">' + o.i + '</span>' : '') +
        '<span class="dd-txt"><span>' + L(o) + '</span>' + (o.age ? '<span class="dd-sub">' + t('recShort') + ': ' + L(o.age) + '</span>' : '') + '</span></div>';
    }

    function renderList() {
      const sel = cfg.get(), max = cfg.max ? cfg.max() : 1;
      let html = '';
      if (cfg.groups) {
        cfg.groups().forEach(g => {
          const items = g.items.filter(match);
          if (items.length) html += '<div class="dd-group">' + (g.i ? g.i + ' ' : '') + L(g) + '</div>' + items.map(o => optHTML(o, sel, max)).join('');
        });
      } else html = cfg.options().filter(match).map(o => optHTML(o, sel, max)).join('');
      list.innerHTML = html || '<div class="dd-none">' + t('noResults') + '</div>';
      root.querySelector('.dd-count').textContent = max > 1 ? t('selectedN').replace('{n}', sel.length) + ' / ' + max : t('single');
      root.querySelector('.dd-clear').textContent = t('clearSel');
      if (search) search.placeholder = t('search');
    }

    function renderTrigger() {
      const sel = cfg.get(), all = flat();
      const val = root.querySelector('.dd-value');
      if (!sel.length) {
        const max = cfg.max ? cfg.max() : 1;
        val.innerHTML = '<span class="dd-ph">' + (max > 1 ? t('chooseMany') : t('choose')) + '</span>';
      } else {
        val.innerHTML = sel.map(id => { const o = all.find(x => x.id === id); return o ? '<span class="chip">' + (o.i ? o.i + ' ' : '') + L(o) + '</span>' : ''; }).join('');
      }
    }

    function open() { closeAll(root); root.classList.add('open'); trig.setAttribute('aria-expanded', 'true'); q = ''; if (search) { search.value = ''; } renderList(); if (search && window.matchMedia('(min-width: 641px)').matches) search.focus(); }
    function close() { root.classList.remove('open'); trig.setAttribute('aria-expanded', 'false'); }

    function toggle(id) {
      const max = cfg.max ? cfg.max() : 1;
      let sel = cfg.get().slice();
      if (max === 1) {
        sel = sel[0] === id ? [] : [id];
        cfg.set(sel); close(); trig.focus();
      } else {
        if (sel.includes(id)) sel = sel.filter(x => x !== id);
        else { if (sel.length >= max) { toast(t('maxN').replace('{n}', max)); return; } sel.push(id); }
        cfg.set(sel); renderList();
      }
      update();
    }

    trig.addEventListener('click', () => root.classList.contains('open') ? close() : open());
    // el panel se redibuja al marcar; evitamos que ese clic lo cierre
    root.querySelector('.dd-panel').addEventListener('click', e => e.stopPropagation());
    list.addEventListener('click', e => { const o = e.target.closest('.dd-opt'); if (o) toggle(o.dataset.id); });
    list.addEventListener('keydown', e => {
      const o = e.target.closest('.dd-opt'); if (!o) return;
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(o.dataset.id); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const all = [...list.querySelectorAll('.dd-opt')], i = all.indexOf(o);
        const next = e.key === 'ArrowDown' ? all[i + 1] : (all[i - 1] || search || trig);
        if (next) next.focus();
      }
    });
    root.addEventListener('keydown', e => { if (e.key === 'Escape') { close(); trig.focus(); } });
    if (search) {
      search.addEventListener('input', () => { q = search.value.trim().toLowerCase(); renderList(); });
      search.addEventListener('keydown', e => { if (e.key === 'ArrowDown') { e.preventDefault(); const f = list.querySelector('.dd-opt'); if (f) f.focus(); } });
    }
    root.querySelector('.dd-clear').addEventListener('click', () => { cfg.set([]); renderList(); update(); });

    const api = { root, render() { renderTrigger(); if (root.classList.contains('open')) renderList(); }, close };
    dropdowns.push(api);
    return api;
  }
  function closeAll(except) { dropdowns.forEach(d => { if (d.root !== except) d.close(); }); }
  document.addEventListener('click', e => { if (!e.target.closest('.dd')) closeAll(null); });

  /* helpers: S = una sola opción, M = varias */
  const S = key => ({ get: () => (state[key] ? [state[key]] : []), set: ids => { state[key] = ids[0] || null; } });
  const M = key => ({ get: () => state[key], set: ids => { state[key] = ids; } });
  const maxChars = () => (state.count === '2' ? 2 : state.count === 'group' ? 3 : 1);

  /* ---------- crear desplegables del generador ---------- */
  makeDD('dd-style', Object.assign({ options: () => D.styles }, S('style')));
  makeDD('dd-chars', Object.assign({ options: () => D.characters, search: true, max: maxChars }, M('chars')));
  makeDD('dd-outfit', Object.assign({ options: () => D.outfits, search: true }, S('outfit')));
  makeDD('dd-details', {
    options: () => D.details, max: () => 6, get: () => state.details,
    set: ids => {
      // una sola pose a la vez
      const added = ids.find(id => !state.details.includes(id));
      const addedPose = added && (D.details.find(d => d.id === added) || {}).g === 'pose';
      state.details = addedPose ? ids.filter(id => id === added || (D.details.find(d => d.id === id) || {}).g !== 'pose') : ids;
    }
  });
  makeDD('dd-theme', Object.assign({ groups: () => D.themeGroups, search: true }, S('theme')));
  makeDD('dd-activity', Object.assign({ options: () => D.activities, search: true }, S('activity')));
  makeDD('dd-comp', Object.assign({ options: () => D.compositions }, S('comp')));
  makeDD('dd-compExtras', Object.assign({ options: () => D.compExtras, max: () => 4 }, M('compExtras')));
  makeDD('dd-level', { options: () => D.levels, get: () => (state.level ? [state.level] : []), set: ids => { state.level = ids[0] || null; checkKids(state); } });
  makeDD('dd-audience', { options: () => D.audiences, get: () => (state.audience ? [state.audience] : []), set: ids => { state.audience = ids[0] || null; checkKids(state); } });
  makeDD('dd-format', Object.assign({ options: () => D.formats }, S('format')));
  makeDD('dd-layout', Object.assign({ options: () => D.layouts }, S('layout')));

  /* ---------- desplegables del modo libro ---------- */
  const BS = key => ({ get: () => (book[key] ? [book[key]] : []), set: ids => { book[key] = ids[0] || null; } });
  makeDD('dd-bWorld', Object.assign({ options: () => B.worlds }, BS('world')));
  makeDD('dd-bChar', Object.assign({ options: () => D.characters, search: true }, BS('char')));
  makeDD('dd-bStyle', Object.assign({ options: () => D.styles }, BS('style')));
  makeDD('dd-bAudience', { options: () => D.audiences, get: () => (book.audience ? [book.audience] : []), set: ids => { book.audience = ids[0] || null; checkKids(book); } });
  makeDD('dd-bLevel', { options: () => D.levels, get: () => (book.level ? [book.level] : []), set: ids => { book.level = ids[0] || null; checkKids(book); } });

  /* ---------- botones segmentados ---------- */
  function renderSeg(id, items, getV, setV) {
    const el = $(id);
    el.innerHTML = items.map(([v, label]) => '<button type="button" role="radio" aria-checked="' + (getV() === v) + '" data-v="' + v + '">' + label + '</button>').join('');
    el.onclick = e => { const b = e.target.closest('button'); if (!b) return; setV(b.dataset.v); renderSeg(id, items, getV, setV); update(); };
  }
  function renderCount() {
    renderSeg('seg-count', [['1', t('one')], ['2', t('two')], ['group', t('group')]], () => state.count, v => {
      state.count = v;
      const max = maxChars();
      if (state.chars.length > max) state.chars = state.chars.slice(0, max);
    });
  }
  function renderPages() {
    renderSeg('seg-pages', [10, 20, 30, 40, 50].map(n => [String(n), String(n)]), () => String(book.pages), v => { book.pages = Number(v); });
  }

  /* ---------- casillas de impresión ---------- */
  function renderPrint() {
    $('print-list').innerHTML = D.print.map(p => {
      const on = state.print.includes(p.id);
      return '<label class="check' + (on ? ' on' : '') + '"><input type="checkbox" data-id="' + p.id + '"' + (on ? ' checked' : '') + '><span class="box" aria-hidden="true"></span><span>' + L(p) + '</span></label>';
    }).join('');
  }
  $('print-list').addEventListener('change', e => {
    const id = e.target.dataset.id; if (!id) return;
    state.print = e.target.checked ? state.print.concat(id) : state.print.filter(x => x !== id);
    renderPrint(); update();
  });

  /* ---------- campos de texto ---------- */
  ['customChar', 'customOutfit', 'customActivity', 'custom'].forEach(id => {
    $(id).addEventListener('input', e => { state[id] = e.target.value; update(); });
  });
  $('bCustomChar').addEventListener('input', e => { book.customChar = e.target.value; });

  /* =========================================================
     ACTUALIZAR VISTA
     ========================================================= */
  function hasContent() { return !!(state.style || state.chars.length || state.theme || state.activity); }

  function update() {
    $('wrap-customChar').classList.toggle('show', state.chars.includes('custom'));
    $('wrap-customOutfit').classList.toggle('show', state.outfit === 'custom');
    $('wrap-customActivity').classList.toggle('show', state.activity === 'custom');
    $('wrap-bCustom').classList.toggle('show', book.char === 'custom');

    const done = {
      style: !!state.style, chars: state.chars.length > 0, outfit: !!state.outfit || state.details.length > 0,
      theme: !!state.theme, activity: !!state.activity, comp: !!state.comp || state.compExtras.length > 0,
      level: !!state.level, audience: !!state.audience, format: !!state.format || !!state.layout,
      print: state.print.length > 0, custom: !!state.custom.trim()
    };
    document.querySelectorAll('.step').forEach(s => s.classList.toggle('done', !!done[s.dataset.step]));

    dropdowns.forEach(d => d.render());
    showRec('rec-level', state.level);
    showRec('rec-bLevel', book.level);
    manual = false;
    showPrompt(hasContent() ? E.buildPrompt(state) : '');
  }

  function showRec(id, levelId) {
    const lv = D.levels.find(x => x.id === levelId);
    $(id).hidden = !lv;
    if (lv) $(id).textContent = '💡 ' + t('recFor') + ': ' + L(lv.age);
  }

  /* confeti de corazones y estrellas */
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  function burst(el) {
    if (!el || calm.matches) return;
    const r = el.getBoundingClientRect();
    if (!r.width) return;
    const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
    const shapes = ['♥', '★', '✦', '♥', '✿'], colors = ['#EC4899', '#9B87D6', '#3FAF84', '#F08A55', '#F472B6'];
    for (let i = 0; i < 14; i++) {
      const s = document.createElement('span');
      s.className = 'burst'; s.textContent = shapes[i % shapes.length];
      s.style.left = cx + 'px'; s.style.top = cy + 'px'; s.style.color = colors[i % colors.length];
      s.style.setProperty('--dx', (Math.random() * 180 - 90).toFixed(0) + 'px');
      s.style.setProperty('--dy', (-30 - Math.random() * 90).toFixed(0) + 'px');
      s.style.setProperty('--rot', (Math.random() * 120 - 60).toFixed(0) + 'deg');
      document.body.appendChild(s);
      setTimeout(() => s.remove(), 1000);
    }
  }
  let saysTimer;
  function hop() {
    const m = $('mascot'); m.classList.remove('hop'); void m.offsetWidth; m.classList.add('hop', 'says');
    clearTimeout(saysTimer); saysTimer = setTimeout(() => m.classList.remove('says'), 2600);
  }

  function showPrompt(text, flash) {
    current = text;
    $('sheet').classList.toggle('empty', !text);
    const box = $('promptBox');
    box.textContent = text || t('emptyPrompt');
    box.style.color = text ? '' : 'var(--muted)';
    if (flash) { box.classList.remove('flash'); void box.offsetWidth; box.classList.add('flash'); }
    const ar = E.aspect(state);
    $('aspectTip').hidden = !ar || !text;
    if (ar) $('aspectTip').textContent = t('aspect').replace('{ar}', ar);
  }

  /* ---------- copiar ---------- */
  function copyText(text, msg) {
    if (!text) { toast(t('nothing')); return; }
    const done = () => toast(msg || t('copied'));
    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, () => fallbackCopy(text, done));
    else fallbackCopy(text, done);
  }
  function fallbackCopy(text, done) {
    const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); done(); } catch (e) { /* nada */ }
    ta.remove();
  }

  /* =========================================================
     HISTORIAL (localStorage)
     ========================================================= */
  let history = store.get('cbg_history', []);
  function addHistory(text, star) {
    if (!text) return;
    const found = history.find(h => h.text === text);
    if (found) { if (star) found.star = true; }
    else history.unshift({ id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6), text, ts: Date.now(), star: !!star });
    // máximo 30; los guardados (⭐) no se borran solos
    while (history.length > 30) { const i = history.map(h => h.star).lastIndexOf(false); if (i === -1) break; history.splice(i, 1); }
    store.set('cbg_history', history); renderHistory();
  }
  function renderHistory() {
    $('histCount').textContent = history.length;
    $('histEmpty').hidden = history.length > 0;
    const fmt = ts => new Date(ts).toLocaleString(lang === 'es' ? 'es' : 'en', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    $('histList').innerHTML = history.map(h =>
      '<li class="hist-item" data-id="' + h.id + '"><div class="meta">' + (h.star ? '⭐ ' : '') + fmt(h.ts) + '</div>' +
      '<div class="text">' + escapeHTML(h.text) + '</div>' +
      '<button class="mini" data-act="view">' + t('view') + '</button><button class="mini" data-act="copy">' + t('copyOne') + '</button><button class="mini del" data-act="del">' + t('del') + '</button></li>'
    ).join('');
  }
  $('histList').addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    const id = b.closest('.hist-item').dataset.id, h = history.find(x => x.id === id); if (!h) return;
    if (b.dataset.act === 'view') { showPrompt(h.text, true); manual = true; $('sheet').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    if (b.dataset.act === 'copy') copyText(h.text);
    if (b.dataset.act === 'del') { history = history.filter(x => x.id !== id); store.set('cbg_history', history); renderHistory(); }
  });
  const escapeHTML = s => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  /* =========================================================
     ACCIONES
     ========================================================= */
  function generate(e) {
    if (!hasContent()) { toast(t('nothing')); return; }
    showPrompt(E.buildPrompt(state), true);
    burst(e && e.currentTarget ? e.currentTarget : $('btnGenerate')); hop();
    addHistory(current);
    if (window.matchMedia('(max-width: 1000px)').matches) $('sheet').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('btnGenerate').onclick = generate;
  $('btnGenerateM').onclick = generate;

  $('btnCopy').onclick = e => { if (current) burst(e.currentTarget); copyText(current); };
  $('btnAgain').onclick = () => {
    if (!hasContent()) { toast(t('nothing')); return; }
    showPrompt(E.oneVariation(state), true); manual = true; addHistory(current); hop();
  };
  $('btnSave').onclick = () => { if (!current) { toast(t('nothing')); return; } addHistory(current, true); toast(t('saved')); };
  $('btnClear').onclick = () => { showPrompt(''); $('varsPanel').hidden = true; toast(t('cleared')); };

  let vars = [];
  function renderVars() {
    $('varList').innerHTML = vars.map((v, i) =>
      '<li class="var-item"><strong>' + (i + 1) + '.</strong><p>' + escapeHTML(v) + '</p><button class="mini" data-i="' + i + '">' + t('copyOne') + '</button></li>').join('');
  }
  $('btnVars').onclick = () => {
    if (!hasContent()) { toast(t('nothing')); return; }
    vars = E.variations(state, 5); renderVars();
    $('varsPanel').hidden = false; $('varsPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };
  $('varList').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { burst(b); copyText(vars[+b.dataset.i]); } });

  function surprise(e) {
    const s = E.surprise();
    const keep = { print: state.print, format: state.format, layout: state.layout };
    Object.assign(state, fresh(), s, keep);
    ['customChar', 'customOutfit', 'customActivity', 'custom'].forEach(id => { $(id).value = ''; });
    renderCount(); update(); generate({ currentTarget: e && e.currentTarget }); toast(t('surpriseDone'));
  }
  $('btnSurprise').onclick = surprise;
  $('btnSurpriseM').onclick = surprise;

  $('btnReset').onclick = () => {
    Object.assign(state, fresh());
    ['customChar', 'customOutfit', 'customActivity', 'custom'].forEach(id => { $(id).value = ''; });
    $('varsPanel').hidden = true;
    renderCount(); renderPrint(); update(); toast(t('resetDone'));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  document.querySelectorAll('[data-close]').forEach(b => b.addEventListener('click', () => { $(b.dataset.close).hidden = true; }));

  /* ---------- modo libro ---------- */
  $('btnBook').onclick = () => {
    if (!book.char && state.chars[0]) { book.char = state.chars[0]; book.customChar = state.customChar; $('bCustomChar').value = state.customChar; }
    if (!book.style) book.style = state.style;
    if (!book.audience) book.audience = state.audience;
    if (!book.level) book.level = state.level;
    $('bookModal').hidden = false; update();
  };
  $('bookModal').addEventListener('click', e => { if (e.target.id === 'bookModal') $('bookModal').hidden = true; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !$('bookModal').hidden && !document.querySelector('.dd.open')) $('bookModal').hidden = true; });

  function renderBook() {
    $('bookList').innerHTML = bookPages.map((p, i) =>
      '<li class="book-item"><span class="pg">' + t('page') + ' ' + p.n + '</span> <strong>' + escapeHTML(lang === 'es' ? p.es : p.en) + '</strong>' +
      '<p>' + escapeHTML(p.prompt) + '</p><button class="mini" data-i="' + i + '">' + t('copyOne') + '</button></li>').join('');
    $('btnCopyBook').hidden = !bookPages.length;
  }
  $('btnBuildBook').onclick = () => {
    if (!book.world || !book.char || (book.char === 'custom' && !book.customChar.trim())) { toast(t('bookNeed')); return; }
    bookPages = E.buildBook(book, state); renderBook();
  };
  $('bookList').addEventListener('click', e => { const b = e.target.closest('button'); if (b) { burst(b); copyText(bookPages[+b.dataset.i].prompt); } });
  $('btnCopyBook').onclick = e => { burst(e.currentTarget); copyText(bookPages.map(p => t('page') + ' ' + p.n + ' — ' + (lang === 'es' ? p.es : p.en) + '\n' + p.prompt).join('\n\n'), t('bookCopied')); };

  /* ---------- idioma ---------- */
  function applyLang() {
    document.documentElement.lang = lang;
    document.querySelectorAll('[data-i18n]').forEach(el => { el.textContent = t(el.dataset.i18n); });
    document.querySelectorAll('[data-i18n-ph]').forEach(el => { el.placeholder = t(el.dataset.i18nPh); });
    document.querySelectorAll('.lang span').forEach(s => s.classList.toggle('on', s.dataset.l === lang));
    renderCount(); renderPages(); renderPrint(); renderHistory();
    if (vars.length) renderVars();
    if (bookPages.length) renderBook();
    if (manual) { const keep = current; update(); showPrompt(keep); manual = true; } else update();
  }
  $('btnLang').onclick = () => { lang = lang === 'es' ? 'en' : 'es'; store.set('cbg_lang', lang); applyLang(); };

  applyLang();
})();

</script>
</body>
</html>
