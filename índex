<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Coloring Book Prompt Generator · Johanna Digital Seattle</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500..800&family=DM+Sans:opsz,wght@9..40,400..700&display=swap" rel="stylesheet">
  <style>
/* =========================================================
   Coloring Book Prompt Generator — STYLES
   Idea central: los números de cada sección son contornos
   "sin colorear" que se rellenan de rosa cuando eliges algo.
   ========================================================= */
:root {
  --blush: #FFF5F8;
  --paper: #FFFFFF;
  --pink-soft: #FAD4E4;
  --pink-mist: #FDEAF2;
  --pink: #EC4899;
  --pink-deep: #C8337A;
  --lavender: #EEE8FB;
  --lavender-ink: #7B68B5;
  --plum: #43263F;
  --muted: #86677F;
  --line: #F1D9E4;
  --shadow: 0 1px 2px rgba(120, 40, 90, .06), 0 8px 24px rgba(200, 51, 122, .07);
  --r-lg: 26px;
  --r-md: 18px;
  --r-pill: 999px;
  --round: "Baloo 2", "Nunito", "Trebuchet MS", system-ui, sans-serif;
  --mint: #EEFBF5; --mint-line: #CBEEDD; --mint-fill: #BFEBD6; --mint-ink: #2E8B67;
  --peach: #FFF3EA; --peach-line: #FBDCC6; --peach-fill: #FDD2B5; --peach-ink: #C9622F;
  --lav: #F6F2FF; --lav-line: #E4DBFA; --lav-fill: #D9CCF7;
  --sans: "DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
*, *::before, *::after { box-sizing: inherit; }
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
body {
  margin: 0; background: var(--blush); color: var(--plum);
  font-family: var(--sans); font-size: 16px; line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
button, input, textarea { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid rgba(236, 72, 153, .45); outline-offset: 2px; border-radius: 10px; }

/* ---------- encabezado ---------- */
.top { background: var(--paper); border-bottom: 1px solid var(--line); }
.top-inner { max-width: 1240px; margin: 0 auto; padding: 22px 24px; display: flex; gap: 20px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.brand { display: flex; gap: 16px; align-items: center; }
.brand-art { width: 104px; height: auto; flex: none; overflow: visible; }
.title { font-family: var(--round); font-weight: 600; font-size: clamp(1.55rem, 1.1rem + 1.6vw, 2.3rem); line-height: 1.1; margin: 0; letter-spacing: -.01em; }
.spark { font-size: .7em; vertical-align: .25em; }
.subtitle { margin: 6px 0 0; color: var(--muted); font-size: 1.02rem; }
.top-actions { display: flex; gap: 10px; align-items: center; }

.lang { display: inline-flex; border: 1px solid var(--line); border-radius: var(--r-pill); padding: 3px; background: var(--blush); cursor: pointer; }
.lang span { padding: 6px 12px; border-radius: var(--r-pill); font-weight: 600; font-size: .85rem; color: var(--muted); transition: background .2s, color .2s; }
.lang span.on { background: var(--pink); color: #fff; }

/* ---------- botones ---------- */
.btn { border: 0; cursor: pointer; border-radius: var(--r-pill); padding: 12px 20px; font-weight: 600; line-height: 1.2; transition: transform .15s ease, background .2s, box-shadow .2s, color .2s; }
.btn:active { transform: scale(.97); }
.btn-primary { background: var(--pink) !important; color: #fff; box-shadow: 0 6px 18px rgba(236, 72, 153, .3); }
.btn-primary:hover { background: var(--pink-deep) !important; }
.btn-soft { background: var(--pink-mist); color: var(--pink-deep); }
.btn-soft:hover { background: var(--pink-soft); }
.btn-ghost { background: var(--lavender); color: var(--lavender-ink); }
.btn-ghost:hover { background: #E3DAF8; }
.btn-text { background: transparent; color: var(--muted); padding: 12px 14px; }
.btn-text:hover { color: var(--pink-deep); }
.btn-surprise { background: var(--paper); color: var(--plum); border: 1.5px dashed var(--pink); padding: 12px 22px; }
.btn-surprise:hover { background: var(--pink-mist); }

/* ---------- layout ---------- */
.layout { max-width: 1240px; margin: 0 auto; padding: 28px 24px 120px; display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 28px; align-items: start; }
.builder { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.builder-bar { display: flex; gap: 8px; align-items: center; justify-content: space-between; }

.step { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px 26px 26px; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 8px 18px; }
.num {
  font-family: var(--round); font-weight: 700;
  font-size: 2.9rem; line-height: .9; color: transparent;
  -webkit-text-stroke: 1.6px var(--plum); transition: color .45s ease, -webkit-text-stroke-color .45s ease;
}
.step.done .num { color: var(--pink-soft); -webkit-text-stroke-color: var(--pink-deep); }
.step h2 { font-family: var(--round); font-weight: 600; font-size: 1.35rem; margin: 2px 0 0; line-height: 1.25; }
.hint { margin: 2px 0 14px; color: var(--muted); }
.label { margin: 14px 0 6px; font-weight: 600; font-size: .92rem; }
.step-body > .label:first-of-type { margin-top: 0; }
.tip { margin: 6px 0 0; font-size: .85rem; color: var(--lavender-ink); }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
.grid2 .label, .grid3 .label { margin-top: 0; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 14px; margin-top: 14px; }

.field { width: 100%; border: 1.5px solid var(--line); border-radius: var(--r-md); padding: 12px 16px; background: var(--paper); transition: border-color .2s; }
.field:focus { border-color: var(--pink); outline: none; }
.area { resize: vertical; min-height: 110px; line-height: 1.5; }
.reveal { display: none; margin-top: 12px; }
.reveal.show { display: block; }

/* segmentado */
.seg { display: flex; flex-wrap: wrap; gap: 8px; }
.seg button { border: 1.5px solid var(--line); background: var(--paper); border-radius: var(--r-pill); padding: 9px 16px; cursor: pointer; font-weight: 600; transition: all .2s; }
.seg button:hover { border-color: var(--pink-soft); }
.seg button[aria-checked="true"] { background: var(--pink); border-color: var(--pink); color: #fff; }

/* ---------- dropdown con casillas ---------- */
.dd { position: relative; }
.dd-trigger { width: 100%; display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 8px 14px 8px 16px; background: var(--paper); border: 1.5px solid var(--line); border-radius: var(--r-md); cursor: pointer; text-align: left; transition: border-color .2s, box-shadow .2s; }
.dd-trigger:hover { border-color: var(--pink-soft); }
.dd.open .dd-trigger { border-color: var(--pink); box-shadow: 0 0 0 4px var(--pink-mist); }
.dd-value { flex: 1; display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
.dd-ph { color: var(--muted); }
.chip { display: inline-flex; align-items: center; gap: 6px; background: var(--pink-mist); color: var(--pink-deep); border-radius: var(--r-pill); padding: 5px 12px; font-weight: 600; font-size: .9rem; }
.dd-caret { width: 20px; height: 20px; flex: none; color: var(--muted); transition: transform .2s; }
.dd.open .dd-caret { transform: rotate(180deg); }
.dd-panel { position: absolute; z-index: 40; left: 0; right: 0; top: calc(100% + 8px); background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--shadow); padding: 8px; display: none; }
.dd.open .dd-panel { display: block; }
.dd-search { width: 100%; border: 1.5px solid var(--line); border-radius: 12px; padding: 10px 14px; margin-bottom: 6px; }
.dd-search:focus { outline: none; border-color: var(--pink); }
.dd-list { max-height: 300px; overflow-y: auto; overscroll-behavior: contain; }
.dd-group { position: sticky; top: 0; background: var(--paper); font-size: .8rem; font-weight: 700; color: var(--lavender-ink); padding: 10px 10px 4px; z-index: 1; }
.dd-opt { display: flex; align-items: center; gap: 12px; padding: 9px 10px; border-radius: 12px; cursor: pointer; user-select: none; }
.dd-opt:hover, .dd-opt.kb { background: var(--blush); }
.dd-opt input { position: absolute; opacity: 0; pointer-events: none; }
.box { width: 20px; height: 20px; border: 1.8px solid #D9B8C9; border-radius: 6px; flex: none; display: grid; place-items: center; transition: all .15s; background: var(--paper); }
.dd-opt.on .box { background: var(--pink); border-color: var(--pink); }
.dd-opt.on .box::after { content: ""; width: 10px; height: 6px; border-left: 2.4px solid #fff; border-bottom: 2.4px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }
.dd-opt.off { opacity: .45; }
.dd-ico { width: 22px; text-align: center; flex: none; }
.dd-txt { display: flex; flex-direction: column; min-width: 0; }
.dd-sub { font-size: .8rem; color: var(--muted); line-height: 1.35; }
.rec { margin: 10px 0 0; font-size: .88rem; background: var(--lavender); color: var(--lavender-ink); padding: 9px 12px; border-radius: 12px; }
.dd-foot { display: flex; justify-content: space-between; align-items: center; padding: 6px 4px 2px; border-top: 1px solid var(--line); margin-top: 6px; font-size: .85rem; color: var(--muted); }
.dd-foot button { background: none; border: 0; color: var(--pink-deep); font-weight: 600; cursor: pointer; padding: 6px 8px; }
.dd-none { padding: 14px 10px; color: var(--muted); }

/* ---------- casillas de impresión ---------- */
.checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; }
.check { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1.5px solid var(--line); border-radius: 14px; cursor: pointer; transition: border-color .2s, background .2s; }
.check input { position: absolute; opacity: 0; pointer-events: none; }
.check.on { border-color: var(--pink-soft); background: var(--pink-mist); }
.check.on .box { background: var(--pink); border-color: var(--pink); }
.check.on .box::after { content: ""; width: 10px; height: 6px; border-left: 2.4px solid #fff; border-bottom: 2.4px solid #fff; transform: rotate(-45deg) translate(1px, -1px); }

/* ---------- resultado: una "hoja" imprimible ---------- */
.side { position: sticky; top: 20px; display: flex; flex-direction: column; gap: 16px; }
.sheet { background: var(--paper); border-radius: var(--r-lg); padding: 22px 22px 18px 34px; box-shadow: var(--shadow); position: relative; border: 1px solid var(--line); }
.sheet::before { content: ""; position: absolute; left: 20px; top: 18px; bottom: 18px; border-left: 2px dotted var(--pink-soft); }
.sheet-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.sheet h2 { font-family: var(--round); font-weight: 600; font-size: 1.3rem; margin: 0; }
.live { font-size: .8rem; color: var(--lavender-ink); }
.prompt-box { margin: 14px 0 10px; min-height: 180px; max-height: 42vh; overflow-y: auto; font-size: .95rem; line-height: 1.65; white-space: pre-wrap; color: var(--plum); }
.prompt-box.flash { animation: flash .6s ease; }
@keyframes flash { from { background: var(--pink-mist); } to { background: transparent; } }
.aspect { margin: 0 0 12px; font-size: .88rem; background: var(--lavender); color: var(--lavender-ink); padding: 9px 12px; border-radius: 12px; }
.btn-generate { width: 100%; padding: 15px; font-size: 1.02rem; }
.result-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.result-actions .btn { padding: 9px 14px; font-size: .88rem; }

.panel { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 18px 20px; }
.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.panel h3 { font-family: var(--round); font-weight: 600; font-size: 1.1rem; margin: 0; }
.x { border: 0; background: var(--blush); width: 34px; height: 34px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; color: var(--muted); flex: none; }
.x:hover { color: var(--pink-deep); }
.var-list, .hist-list, .book-list { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.var-item, .book-item { border: 1px solid var(--line); border-radius: 16px; padding: 12px 14px; }
.var-item p, .book-item p { margin: 6px 0 8px; font-size: .88rem; line-height: 1.55; }
.var-item strong, .book-item strong { font-family: var(--round); font-weight: 600; }
.mini { background: var(--pink-mist); color: var(--pink-deep); border: 0; border-radius: var(--r-pill); padding: 6px 12px; font-weight: 600; font-size: .82rem; cursor: pointer; margin-right: 4px; }
.mini:hover { background: var(--pink-soft); }
.mini.del { background: transparent; color: var(--muted); }

.history summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
.history summary::-webkit-details-marker { display: none; }
.count { background: var(--lavender); color: var(--lavender-ink); font-weight: 700; font-size: .8rem; border-radius: var(--r-pill); padding: 2px 10px; }
.hist-item { border-bottom: 1px solid var(--line); padding-bottom: 10px; }
.hist-item:last-child { border-bottom: 0; }
.hist-item .meta { font-size: .78rem; color: var(--muted); }
.hist-item .text { font-size: .86rem; margin: 4px 0 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hist-empty { color: var(--muted); font-size: .9rem; margin: 10px 0 0; }

/* ---------- modal libro ---------- */
.modal { position: fixed; inset: 0; background: rgba(67, 38, 63, .35); z-index: 60; display: flex; justify-content: center; align-items: flex-start; padding: calc(24px + env(safe-area-inset-top, 0px)) 16px 24px; overflow-y: auto; }
.modal[hidden] { display: none; }
.modal-card { background: var(--paper); border-radius: var(--r-lg); width: min(860px, 100%); padding: 26px; box-shadow: 0 20px 60px rgba(67, 38, 63, .25); }
.modal-card h2 { font-family: var(--round); font-weight: 600; font-size: 1.6rem; margin: 0; }
.modal-card .grid2 { margin-top: 10px; }
.modal-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
.book-item .pg { color: var(--pink-deep); font-weight: 700; font-size: .82rem; }

/* ---------- toast ---------- */
.toast { position: fixed; left: 50%; bottom: calc(96px + env(safe-area-inset-bottom, 0px)); transform: translate(-50%, 20px); background: var(--plum); color: #fff; padding: 12px 20px; border-radius: var(--r-pill); font-weight: 600; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; z-index: 80; max-width: 90vw; text-align: center; }
.toast.show { opacity: 1; transform: translate(-50%, 0); }

/* ---------- barra móvil ---------- */
.mobile-bar { display: none; }

@media (max-width: 1000px) {
  .layout { grid-template-columns: 1fr; }
  .side { position: static; }
  .prompt-box { max-height: none; }
}
@media (max-width: 640px) {
  .top-inner { padding: 16px; }
  .brand-art { width: 72px; }
  .layout { padding: 18px 12px 110px; gap: 18px; }
  .step { grid-template-columns: 1fr; padding: 20px 18px; }
  .num { font-size: 2.2rem; }
  .grid2, .grid3 { grid-template-columns: 1fr; }
  .grid2 > div + div, .grid3 > div + div { margin-top: 14px; }
  .builder-bar .btn-surprise { display: none; }
  .mobile-bar { display: flex; gap: 10px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px)); background: rgba(255, 255, 255, .96); border-top: 1px solid var(--line); }
  .mobile-bar .btn-primary { flex: 1; }
  .mobile-bar .sm { padding: 12px 16px; }
  .modal-card { padding: 20px 16px; }
  .toast { bottom: calc(90px + env(safe-area-inset-bottom, 0px)); }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; }
}


/* =========================================================
   VERSIÓN CUTE: tonos pastel, letra redondita, dibujitos,
   animaciones y mascota
   ========================================================= */
.title { font-weight: 800; letter-spacing: 0; }
.step h2, .sheet h2, .panel h3, .modal-card h2 { font-weight: 700; }
.num { font-weight: 800; justify-self: start; transform-origin: left center; }

/* cada sección con su crayón pastel */
.step { --tint: #FFF0F6; --edge: #F8D3E4; --fill: var(--pink-soft); --ink: var(--pink-deep); background: var(--tint); border: 2px solid var(--edge); }
.step:nth-of-type(4n+2) { --tint: var(--lav); --edge: var(--lav-line); --fill: var(--lav-fill); --ink: var(--lavender-ink); }
.step:nth-of-type(4n+3) { --tint: var(--mint); --edge: var(--mint-line); --fill: var(--mint-fill); --ink: var(--mint-ink); }
.step:nth-of-type(4n+4) { --tint: var(--peach); --edge: var(--peach-line); --fill: var(--peach-fill); --ink: var(--peach-ink); }
.step .num { -webkit-text-stroke-color: var(--ink); }
.step.done .num { color: var(--fill); -webkit-text-stroke-color: var(--ink); animation: pop .55s ease; }
@keyframes pop { 0% { transform: scale(1); } 40% { transform: scale(1.28) rotate(-7deg); } 70% { transform: scale(.95) rotate(3deg); } 100% { transform: scale(1); } }
.step .dd-trigger, .step .field, .step .seg button, .step .check { border-color: var(--edge); }
.step .check { background: var(--paper); }

/* botones con rebote */
.btn:hover { transform: translateY(-2px); }
.btn:active { transform: translateY(0) scale(.96); }
.btn-surprise { animation: wiggle 6s ease-in-out infinite; }
.btn-surprise:hover { animation: none; }
@keyframes wiggle { 0%, 86%, 100% { transform: rotate(0); } 88% { transform: rotate(-5deg); } 90% { transform: rotate(5deg); } 92% { transform: rotate(-4deg); } 94% { transform: rotate(3deg); } 96% { transform: rotate(0); } }
.spark { display: inline-block; animation: twinkle 1.8s ease-in-out infinite; }
@keyframes twinkle { 0%, 100% { transform: scale(1) rotate(0); opacity: 1; } 50% { transform: scale(.7) rotate(20deg); opacity: .55; } }

/* dibujitos de fondo */
.top, .layout { position: relative; z-index: 1; }
.top { background: rgba(255, 255, 255, .92); }
.doodles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.doodles svg { position: absolute; width: 34px; height: 34px; fill: none; stroke: #F4A9C8; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; opacity: .75; animation: drift 9s ease-in-out infinite; }
.doodles svg.wide { width: 46px; }
.doodles svg.lav { stroke: #B9A6EC; }
.doodles svg.mint { stroke: #86D2B0; }
.doodles svg.peach { stroke: #F4B08A; }
.doodles svg:nth-child(2n) { animation-duration: 11s; animation-delay: -3s; }
.doodles svg:nth-child(3n) { animation-duration: 13s; animation-delay: -6s; }
@keyframes drift { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-16px) rotate(12deg); } }

/* confeti de corazones y estrellas */
.burst { position: fixed; pointer-events: none; z-index: 95; font-size: 18px; line-height: 1; animation: burst .95s ease-out forwards; }
@keyframes burst {
  0% { transform: translate(-50%, -50%) scale(.5); opacity: 1; }
  100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) rotate(var(--rot)) scale(1.1); opacity: 0; }
}

/* mascota: las animaciones viven dentro del dibujo (SMIL) */
.mascot { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 18px 0 10px; }
.m-svg { width: 96px; height: auto; overflow: visible; flex: none; }
.bubble { position: relative; order: 2; background: var(--paper); border: 2px solid var(--plum); border-radius: 18px; padding: 10px 16px; font-family: var(--round); font-weight: 600; font-size: 1.02rem; line-height: 1.3; text-align: center; max-width: 210px; }
.bubble::after { content: ""; position: absolute; left: -9px; top: 50%; width: 14px; height: 14px; background: var(--paper); border-left: 2px solid var(--plum); border-bottom: 2px solid var(--plum); transform: translateY(-50%) rotate(45deg); }
.done-bubble { display: none; }
.sheet.empty .prompt-box { display: none; }

/* con prompt: mascota mediana asomándose en la esquina */
.sheet:not(.empty) { margin-top: 78px; }
.sheet:not(.empty) .mascot { position: absolute; top: -96px; right: 10px; margin: 0; z-index: 2; gap: 8px; }
.sheet:not(.empty) .m-svg { width: 84px; }
.sheet:not(.empty) .bubble { display: none; }
.sheet:not(.empty) .mascot.says .done-bubble { display: block; order: 0; font-size: .95rem; padding: 6px 12px; white-space: nowrap; }
.sheet:not(.empty) .mascot.says .done-bubble::after { left: auto; right: -9px; transform: translateY(-50%) rotate(-135deg); }
.sheet:not(.empty) .sheet-head { padding-right: 96px; }
.sheet:not(.empty) .live { display: none; }
.mascot.hop .m-svg { animation: hop .6s ease; }
@keyframes hop { 0%, 100% { transform: translateY(0); } 35% { transform: translateY(-18px) rotate(-8deg); } 65% { transform: translateY(0) rotate(4deg); } }

@media (max-width: 640px) {
  .doodles svg { width: 24px; height: 24px; opacity: .5; }
  .doodles svg.wide { width: 32px; }
}
@media (prefers-reduced-motion: reduce) {
  .burst { display: none; }
}

</style>
</head>
