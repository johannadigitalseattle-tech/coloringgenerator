  <script>
/* =========================================================
   Coloring Book Prompt Generator — PROMPT ENGINE
   Un solo motor central combina las selecciones en un prompt
   profesional, sin repeticiones ni contradicciones.
   ========================================================= */
(function () {
  const D = window.CBG_DATA;
  const B = window.CBG_BOOK;

  /* ---------- utilidades ---------- */
  const byId = (list, id) => list.find(x => x.id === id) || null;
  const theme = id => byId(D.themes, id);
  const article = w => (/^[aeiou]/i.test(w) ? 'an ' : 'a ') + w;
  const joinAnd = arr => arr.length <= 1 ? (arr[0] || '') : arr.slice(0, -1).join(', ') + ' and ' + arr[arr.length - 1];
  const shuffle = arr => { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  const pick = arr => arr[Math.floor(Math.random() * arr.length)];
  const clean = s => (s || '').trim().replace(/\s+/g, ' ').replace(/[.。]+$/, '');

  /* Niños + niveles complejos no combinan: se baja a "easy" */
  const HEAVY = ['detailed', 'intricate'];
  function safeLevel(state) {
    if (state.audience === 'kids' && HEAVY.includes(state.level)) return 'easy';
    return state.level;
  }

  /* ---------- sujeto / personaje ---------- */
  function charPhrase(c, customText, mode) {
    // mode: 'one' | 'two-same' | 'group-same'
    if (!c) return '';
    if (c.k === 'custom') return clean(customText);
    const n = c.n;
    if (mode === 'two-same') return c.k === 'human' ? 'two cute ' + c.pl : 'two adorable ' + n + ' characters';
    if (mode === 'group-same') return c.k === 'human' ? 'a small group of cute ' + c.pl : 'a small group of adorable ' + n + ' characters';
    switch (c.k) {
      case 'human': return 'a cute ' + n;
      case 'animal': return 'an adorable ' + n + ' character';
      case 'fantasy': return article('charming ' + n);
      case 'object': return article('anthropomorphic ' + n) + ' character with a cute face and tiny arms and legs';
      default: return article(n);
    }
  }

  function subjectPhrase(state) {
    const chars = (state.chars || []).map(id => byId(D.characters, id)).filter(Boolean)
      .filter(c => c.k !== 'custom' || clean(state.customChar));
    if (!chars.length) return '';
    const count = state.count || '1';
    if (chars.length === 1) {
      const mode = count === '2' ? 'two-same' : count === 'group' ? 'group-same' : 'one';
      if (chars[0].k === 'custom') {
        const t = clean(state.customChar);
        if (count === '2') return 'two characters: ' + t;
        if (count === 'group') return 'a small group of characters: ' + t;
        return t;
      }
      return charPhrase(chars[0], state.customChar, mode);
    }
    const list = chars.map(c => charPhrase(c, state.customChar, 'one'));
    return count === 'group' ? 'a small group of friends: ' + joinAnd(list) : joinAnd(list);
  }

  function mainProp(state) {
    const t = theme(state.theme);
    return t && t.props && t.props.length ? t.props[0] : 'a small cute object';
  }

  /* ---------- líneas de impresión ---------- */
  function printFragments(printIds) {
    const has = id => printIds.includes(id);
    const out = [];
    if (has('closed')) out.push('clean closed outlines');
    if (has('black') && has('vector')) out.push('crisp black vector-style line art');
    else if (has('black')) out.push('black line art');
    else if (has('vector')) out.push('vector-style line art');
    if (has('white')) out.push('pure white background');
    const negs = [];
    if (has('nocolor')) negs.push('no color');
    if (has('noshade')) negs.push('no shading', 'no textures');
    if (has('nogray')) negs.push('no gray tones');
    if (has('nograd')) negs.push('no gradients');
    if (negs.length) out.push(negs.join(', '));
    if (has('contrast')) out.push('high contrast');
    if (has('printable')) out.push('printable coloring page, high quality, ready to color');
    const tail = [];
    if (has('notext')) tail.push('no text');
    if (has('nowm')) tail.push('no watermark');
    return { body: out, tail };
  }

  /* =========================================================
     MOTOR CENTRAL
     opts (opcional): pose, decor, secondary, angle, story,
                      scene (modo libro), series (modo libro)
     ========================================================= */
  function buildPrompt(state, opts) {
    opts = opts || {};
    const parts = [];
    const style = byId(D.styles, state.style);
    const comp = byId(D.compositions, state.comp);
    const subject = subjectPhrase(state);
    const count = state.count || '1';

    // [STYLE] + [SUBJECT]
    let head = ((style ? style.lead + ' ' : '') + 'coloring page illustration').trim();
    head = head.charAt(0).toUpperCase() + head.slice(1);
    parts.push(subject ? head + ' of ' + subject : head);
    if (style) parts.push(style.p);

    // [CHARACTER DETAILS]
    if (subject) {
      const det = (state.details || []).map(id => byId(D.details, id)).filter(Boolean);
      const withs = det.filter(d => ['eyes', 'smile', 'blush', 'accessories'].includes(d.id)).map(d => d.p);
      if (withs.length) parts.push('with ' + joinAnd(withs));
      if (det.some(d => d.id === 'fullBody') && !(comp && comp.id === 'closeUp')) parts.push(count === '1' ? 'full-body character' : 'full-body characters');
      if (opts.pose) parts.push(opts.pose);
      else { const pose = det.find(d => d.g === 'pose'); if (pose) parts.push(pose.p); }
      if (det.some(d => d.id === 'holding')) parts.push('holding ' + mainProp(state));
    }

    // [OUTFIT]
    if (subject && state.outfit) {
      const of = byId(D.outfits, state.outfit);
      let txt = of && of.id === 'custom' ? (clean(state.customOutfit) ? 'wearing ' + clean(state.customOutfit) : '') : (of ? of.p : '');
      if (txt && count !== '1') txt = txt.replace(/^wearing/, 'each wearing');
      if (txt) parts.push(txt);
    }

    // [THEME] + [ACTIVITY] + [SCENE]
    if (opts.scene) {
      parts.push(opts.scene);
    } else {
      const act = byId(D.activities, state.activity);
      const actTxt = act ? (act.id === 'custom' ? clean(state.customActivity) : act.p) : '';
      const t = theme(state.theme);
      const env = t ? t.p : '';
      if (actTxt && env) parts.push(actTxt + ' in ' + env);
      else if (actTxt) parts.push(actTxt);
      else if (env) parts.push('set in ' + env);
    }
    if (opts.secondary) parts.push('with ' + opts.secondary + ' nearby');
    if (opts.decor) parts.push(opts.decor);
    if (opts.story) parts.push(opts.story);

    // [COMPOSITION]
    if (comp) parts.push(comp.p);
    if (opts.angle) parts.push(opts.angle);
    (state.compExtras || []).forEach(id => { const e = byId(D.compExtras, id); if (e) parts.push(e.p); });

    // [AUDIENCE] + [COLORING LEVEL]
    const aud = byId(D.audiences, state.audience);
    if (aud) parts.push(aud.p);
    const lvl = byId(D.levels, safeLevel(state));
    if (lvl) parts.push(lvl.p);

    // [FORMAT]
    const fmt = byId(D.formats, state.format);
    if (fmt) parts.push(fmt.p);
    const lay = byId(D.layouts, state.layout);
    if (lay) parts.push(lay.p);

    // modo libro: identidad constante
    if (opts.series) parts.push('the same recurring character design used consistently across a coloring book series');

    // [LINE ART] + [PRINT]
    const pr = printFragments(state.print || []);
    parts.push(...pr.body);

    // [CUSTOM]
    const custom = clean(state.custom);
    if (custom) parts.push('additional details: ' + custom);

    parts.push(...pr.tail);

    // quitar vacíos y repetidos exactos
    const seen = new Set();
    const final = parts.map(clean).filter(p => {
      const k = p.toLowerCase();
      if (!p || seen.has(k)) return false;
      seen.add(k); return true;
    });
    return final.join(', ') + '.';
  }

  /* ---------- bancos para variaciones ---------- */
  const BANK = {
    poses: ['waving hello cheerfully', 'sitting happily with legs crossed', 'walking forward with a joyful step', 'leaning forward with curiosity', 'jumping with joy', 'peeking out shyly from behind an object', 'stretching arms up happily', 'looking over the shoulder with a sweet smile', 'twirling playfully', 'kneeling down to look at something small'],
    decor: ['with small flowers and leaves scattered around', 'with tiny stars and sparkles floating in the air', 'framed by curling vines and little blossoms', 'with small hearts dotting the background', 'with fluffy clouds and a smiling sun above', 'with a bunting garland hanging above', 'with little butterflies fluttering nearby', 'with swirling ribbons and bows', 'with tiny mushrooms and pebbles on the ground', 'with round bubbles floating around'],
    angles: ['wide view that shows more of the setting', 'slightly closer framing on the character', 'centered symmetrical arrangement', 'gentle diagonal layout that suggests movement', 'layered depth with foreground, middle ground and background'],
    secondary: ['a tiny companion bird', 'a small potted plant', 'a stack of books', 'a little woven basket', 'a steaming teacup', 'a small lantern', 'a tiny snail friend', 'a sleepy kitten', 'a bouquet of flowers', 'a small gift box'],
    story: ['capturing a sweet everyday moment', 'as if a small happy surprise just happened', 'sharing the moment with a tiny friend', 'in the middle of a cheerful little adventure', 'during a calm peaceful pause']
  };

  function variationOpts(state, i, sets) {
    const t = theme(state.theme);
    const hasSubject = !!subjectPhrase(state);
    const pat = state.comp === 'pattern';
    return {
      pose: hasSubject && !pat ? sets.poses[i % sets.poses.length] : '',
      decor: sets.decor[i % sets.decor.length],
      secondary: sets.secondary[i % sets.secondary.length],
      angle: pat ? '' : sets.angles[i % sets.angles.length],
      story: hasSubject && !pat ? sets.story[i % sets.story.length] : ''
    };
    // t se usa en sets.secondary (props del tema)
  }

  function makeSets(state) {
    const t = theme(state.theme);
    const props = t ? t.props.slice(1) : [];
    return {
      poses: shuffle(BANK.poses), decor: shuffle(BANK.decor), angles: shuffle(BANK.angles),
      secondary: shuffle(props).concat(shuffle(BANK.secondary)), story: shuffle(BANK.story)
    };
  }

  function variations(state, n) {
    const sets = makeSets(state);
    const out = [];
    for (let i = 0; i < (n || 5); i++) out.push(buildPrompt(state, variationOpts(state, i, sets)));
    return out;
  }

  function oneVariation(state) { return variations(state, 1)[0]; }

  /* ---------- Surprise Me ---------- */
  let lastSurprise = -1;
  function surprise() {
    let idx;
    do { idx = Math.floor(Math.random() * D.surprises.length); } while (idx === lastSurprise && D.surprises.length > 1);
    lastSurprise = idx;
    const s = D.surprises[idx];
    return {
      style: s.style, count: '1', chars: s.chars.slice(), outfit: s.outfit || null,
      theme: s.theme, activity: s.activity || null, comp: s.comp,
      level: s.level, audience: s.audience,
      details: s.chars.some(id => { const c = byId(D.characters, id); return c && c.k !== 'object'; }) ? ['eyes', 'smile', 'fullBody'] : ['smile']
    };
  }

  /* ---------- Modo libro ---------- */
  function buildBook(book, base) {
    const world = byId(B.worlds, book.world);
    if (!world) return [];
    const N = book.pages || 20;
    const ending = B.genericScenes[B.genericScenes.length - 1];
    const generics = shuffle(B.genericScenes.slice(0, -1));
    const wScenes = world.scenes.slice(1);
    const middle = [];
    let wi = 0, gi = 0, step = 0;
    while (middle.length < N - 2 && (wi < wScenes.length || gi < generics.length)) {
      const takeWorld = (step % 3 !== 2 && wi < wScenes.length) || gi >= generics.length;
      middle.push(takeWorld ? wScenes[wi++] : generics[gi++]);
      step++;
    }
    const seq = [world.scenes[0]].concat(middle, [ending]).slice(0, N);
    const st = Object.assign({}, base, {
      style: book.style, audience: book.audience, level: book.level,
      count: '1', chars: book.char ? [book.char] : [], customChar: book.customChar,
      activity: null, theme: null, comp: 'charEnv', compExtras: [], custom: ''
    });
    return seq.map((sc, i) => ({
      n: i + 1, en: sc[0], es: sc[1],
      prompt: buildPrompt(st, { scene: sc[2].replace('{place}', world.place), series: true })
    }));
  }

  function aspect(state) { const f = byId(D.formats, state.format); return f ? f.ar : ''; }

  window.CBG_ENGINE = { buildPrompt, variations, oneVariation, surprise, buildBook, aspect, safeLevel, byId };
})();

